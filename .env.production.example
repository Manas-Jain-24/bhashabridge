# Copy to .env.production and restrict its permissions to the operator.
PUBLIC_ORIGIN=https://learn.example.org
PUBLIC_HOST=learn.example.org
AUTH_RATE_SECRET=
POSTGRES_USER=bhasha_owner
POSTGRES_DB=bhashabridge
POSTGRES_PASSWORD=
BB_DB_USER=bhasha_app
BB_DB_PASSWORD=
# postgresql+psycopg://USER:PERCENT_ENCODED_PASSWORD@postgres:5432/bhashabridge
DATABASE_URL=
MIGRATION_DATABASE_URL=
ALLOW_REGISTRATION=true
TRANSLATION_MODE=local
TRANSLATION_ENGINE=indictrans2
# Start with core for the rule-based stack. Use neural with verified weights.
BB_BACKEND_TARGET=core
BB_API_CPUS=2
BB_API_MEMORY=4g
BB_MODEL_DIR=./models
MODEL_MANIFEST=
MODEL_MANIFEST_SHA256=
INFERENCE_WORKERS=1
GEMINI_API_KEY=
CLOUD_CALLS_PER_DAY=100
CLOUD_USER_CALLS_PER_DAY=25
