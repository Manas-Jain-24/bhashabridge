# BhashaBridge Environment Configuration Example
# Copy this file to `backend/.env` for local configuration.

PROJECT_NAME="BhashaBridge"
PROJECT_VERSION="0.1.0"
API_V1_STR="/api"

# Database Configuration (fallback must be explicitly enabled for local development)
# DATABASE_URL=postgresql://bhasha_user:bhasha_pass@localhost:5432/bhashabridge
DATABASE_URL=sqlite:///./bhashabridge.db
ALLOW_SQLITE_FALLBACK=false
TRANSLATION_ENGINE=indictrans2
# hybrid preserves raw input and uses one optional Gemini contextual translation.
# local skips Gemini translation, tutor and generated glosses for the request.
TRANSLATION_MODE=hybrid

# Machine Translation & Indic NLP Configuration
# When true: bypasses heavyweight neural weights and uses calibrated modular conversational fallback
USE_MOCK_MODELS=false
BENGALI_NEURAL_TRANSLITERATION=true
INDICTRANS2_MODEL_CHECKPOINT=ai4bharat/indictrans2-indic-indic-dist-320M
# Optional local decision.json; only a passed, hash-matched Bengali-Marathi adapter loads.
# INDICTRANS2_ADAPTER_DECISION=ml/experiments/translation-quality-v2/decision.json

# Hugging Face Access Token (Optional: only needed if downloading gated/authenticated HF models)
HF_TOKEN=your_huggingface_token_here

# LLM AI Sensei Explanation Layer (Optional)
# If provided, enriches grammar explanations with cultural mnemonics and conversational pragmatics.
# If omitted or offline, automatically fails over cleanly to local Universal Dependencies morphological rules.
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration
# Provide a comma-separated list of allowed frontend origins, or JSON array
# Note: Wildcard "*" disables credentials for security and browser compliance.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Bound optional tutor latency; failures return local/empty explanations.
GEMINI_MODEL=gemini-flash-lite-latest
# Translation is a separate task from short tutor explanations.
GEMINI_TRANSLATION_MODEL=gemini-3.5-flash
GEMINI_TRANSLATION_TIMEOUT_SECONDS=30
GEMINI_TIMEOUT_SECONDS=15

# Local mode is restricted to loopback. Public deployment requires accounts,
# HTTPS and COOKIE_SECURE=true; serve UI and /api from the same origin.
APP_ENV=development
AUTH_MODE=local
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
SESSION_HOURS=24
REQUESTS_PER_MINUTE=120
# Counts include rejected/failed provider attempts and all tutor/gloss calls.
# Set both cloud budgets to zero to disable paid provider requests.
CLOUD_CALLS_PER_DAY=100
CLOUD_USER_CALLS_PER_DAY=25
GEMINI_MAX_OUTPUT_TOKENS=2048
REQUEST_TIMEOUT_SECONDS=60
INFERENCE_WORKERS=2
